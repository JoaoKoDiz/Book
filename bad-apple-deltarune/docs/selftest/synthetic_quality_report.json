  "methodology": {
    "pipeline": [
      "1 inspect files (ffprobe), detect the game area inside black bars (analysis only)",
      "2 decode the ENTIRE gameplay video once; adaptive sampling into a database of 64x48 grey thumbnails with exact timestamps (dense where the picture changes, around cuts/flashes; >=1 frame per max_gap s; duplicates capped)",
      "3/4 exact (brute-force BLAS) coarse retrieval of every reference frame against every database frame",
      "5 detailed multi-scale comparison of diversified candidates; best ones re-decoded at 128x96 and rescored",
      "6 Viterbi optimisation of the whole sequence (similarity vs. rhythm/continuity, bounded accuracy loss)",
      "7 refinement: second-chance search for the worst frames + dense decoding of every frame around the most promising candidates; repeated until the gain is negligible",
      "export: native frames at exact timestamps -> H.264 at the reference frame rate + reference audio"
    ],
    "composition_measures": "multi-scale tone layout (L1 at 24x32,12x16,6x8,3x4), light/dark centroids, spread, left-right / top-bottom balance",
    "structural_measures": "SSIM (48x64, 96x128), zero-mean normalised correlation, balanced figure/ground IoU, silhouette-contour chamfer similarity (distance transform), gradient-orientation histograms",
    "semantic_measures": "disabled by configuration",
    "weights": {
      "composition": 0.5,
      "structural": 0.4,
      "semantic": 0.1
    },
    "coarse_retrieval": "1-RMSE tone (12x16, 24x32), ZNCC (24x32), soft Dice of light and dark regions (24x32)",
    "temporal": "Viterbi; pair cost = lambda_rhythm*|output change - reference change| + lambda_jump*scene jump"
  },
